+private let qwen3TTSICLDiagnosticLock = NSLock()
+
+private func reportQwen3TTSICLStage(_ stage: String) {
+    qwen3TTSICLDiagnosticLock.lock()
+    defer { qwen3TTSICLDiagnosticLock.unlock() }
+    let defaults = UserDefaults.standard
+    let key = "openTihui.ttsDebug.recentLog"
+    var lines = defaults.stringArray(forKey: key) ?? []
+    lines.append("[\(Date().formatted(date: .omitted, time: .standard))] ICL encoder stage — \(stage)")
+    if lines.count > 80 { lines.removeFirst(lines.count - 80) }
+    defaults.set(lines, forKey: key)
+    defaults.synchronize()
+}
