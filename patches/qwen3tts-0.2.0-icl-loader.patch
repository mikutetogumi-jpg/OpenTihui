+    /// Encode only the first codebook. Qwen3-TTS ICL consumes only the first
+    /// semantic code stream, so evaluating the remaining acoustic codebooks
+    /// wastes a large amount of memory on iOS.
+    /// - Parameter x: [B, C, T] (channels-first)
+    /// - Returns: codes [1, B, T]
+    public func encodeFirstCodebook(_ x: MLXArray) -> MLXArray {
+        reportQwen3TTSICLStage("Semantic projection begin")
+        var projected = x.transposed(0, 2, 1)   // [B, T, C]
+        projected = inputProj(projected)          // [B, T, dim]
+        eval(projected)
+        Memory.clearCache()
+        reportQwen3TTSICLStage("Semantic projection complete")
+
+        reportQwen3TTSICLStage("Semantic codebook begin")
+        let indices = layers[0].codebook.encode(projected)  // [B, T]
+        eval(indices)
+        Memory.clearCache()
+        reportQwen3TTSICLStage("Semantic codebook complete")
+
+        return indices.expandedDimensions(axis: 0)  // [1, B, T]
+    }
 }
 
